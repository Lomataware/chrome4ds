{
  "manifest_version": 3,
  "name": "Discord Rich Presence for YouTube & SoundCloud",
  "short_name": "DRP Media",
  "version": "1.0.0",
  "description": "Отправляет в Discord Rich Presence информацию о просматриваемых видео и слушаемых треках (YouTube, YouTube Music, SoundCloud).",

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "scripting"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.music.youtube.com/*",
    "*://*.soundcloud.com/*",
    "https://discord.com/api/*",
    "https://cdn.discordapp.com/*"
  ],

  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": ["content/youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://soundcloud.com/*",
        "*://*.soundcloud.com/*"
      ],
      "js": ["content/soundcloud.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Discord Rich Presence",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  }
}
